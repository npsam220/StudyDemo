<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.StudyDemo.mapper.CartMapper">

    <select id="findById"
        parameterType="long"
        resultType="com.example.StudyDemo.entity.Cart"> SELECT id, user_id, created_at, updated_at
        FROM cart WHERE id = #{id} </select>

    <insert id="insert"
        parameterType="com.example.StudyDemo.entity.Cart"
        useGeneratedKeys="true"
        keyProperty="id"> INSERT INTO cart ( user_id ) VALUES ( #{userId} ) </insert>

</mapper>