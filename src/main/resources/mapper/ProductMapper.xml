<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.StudyDemo.mapper.ProductMapper">
    <select id="search" resultType="com.example.StudyDemo.entity.Product"> SELECT * FROM product <where>
            <if test="id != null"> AND id = #{id} </if>
            <if
                test="productCode != null and productCode != ''"> AND product_code = #{productCode} </if>
            <if
                test="name != null and name != ''"> AND name = #{name} </if>
            <if
                test="pricebegin != null"> AND price <![CDATA[ >= ]]> #{pricebegin} </if>
            <if
                test="priceend != null"> AND price <![CDATA[ <= ]]> #{priceend} </if>
        </where>
    </select>

    <insert id="save" parameterType="com.example.StudyDemo.entity.Product" useGeneratedKeys="true"
        keyProperty="id"> INSERT INTO product (product_code, name, price) VALUES (#{productCode},
        #{name}, #{price}) </insert>

    <select id="findById" parameterType="long" resultType="com.example.StudyDemo.entity.Product">
        SELECT * FROM product WHERE id = #{id} </select>
    <delete id="deleteById" parameterType="long"> DELETE FROM product WHERE id = #{id} </delete>
</mapper>